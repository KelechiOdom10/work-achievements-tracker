{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/server",
    "rootDir": ".",
    "paths": {
      "~/*": ["./server/*"],
      "~/shared/*": ["./shared/*"]
    }
  },
  "include": ["server/**/*", "shared/**/*"],
  "exclude": ["frontend", "node_modules", "**/node_modules/*", "dist"]
}
